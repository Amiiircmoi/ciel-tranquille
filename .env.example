# --- Identifiants OpenSky (OAuth2 client credentials) ---
# Créez un compte sur https://opensky-network.org/ puis une "API client"
# dans votre profil pour obtenir client_id / client_secret.
# NE JAMAIS committer le fichier .env réel (il est gitignoré).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# --- Bounding box COMBINÉE (WGS84) couvrant les 3 stations (correctif crédits) ---
# ≈0,15 deg² → tranche OpenSky la moins chère (1 crédit/appel). Filtrage par
# station en post-traitement. Ordre : lat_min, lon_min, lat_max, lon_max.
CT_BBOX_LAT_MIN=48.65
CT_BBOX_LON_MIN=2.18
CT_BBOX_LAT_MAX=49.09
CT_BBOX_LON_MAX=2.53

# --- Cadence micro-batch (s) : 30 s ≈ 2 880 appels/j < plafond 4000 crédits/j ---
CT_POLL_INTERVAL_S=30

# --- Budget crédits OpenSky (allocation QUOTIDIENNE) + plancher d'arrêt poller ---
CT_DAILY_CREDIT_BUDGET=4000
CT_CREDIT_FLOOR=200

# --- Mode d'ingestion : "live" (API réelle) ou "replay" (snapshots enregistrés) ---
CT_INGEST_MODE=replay

# --- Chemins ---
CT_DATA_DIR=data
