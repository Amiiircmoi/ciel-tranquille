# =============================================================================
# Ciel Tranquille — modèle de configuration.
#
#   cp .env.example .env && chmod 600 .env   puis renseignez les valeurs.
#
# Le fichier `.env` réel est gitignoré et n'est JAMAIS committé. Aucune valeur
# réelle ne figure ici : ni identifiant, ni adresse, ni chemin de serveur.
# =============================================================================

# --- Identifiants OpenSky (OAuth2 client credentials) ------------------------
# Compte sur https://opensky-network.org/ puis « API client » dans le profil.
# Les jetons émis expirent au bout de 30 min et sont rafraîchis automatiquement.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# --- Identité du trafic sortant (OBLIGATOIRE) --------------------------------
# L'IP sortante est partagée avec une application de production tierce : un
# blocage chez OpenSky ou Bruitparif la ferait tomber. Un opérateur doit pouvoir
# nous identifier et nous joindre AVANT d'envisager un blocage.
# Renseignez au minimum une adresse de contact ; laissez CIEL_USER_AGENT vide
# pour un User-Agent construit automatiquement autour de ce contact.
CIEL_CONTACT=
CIEL_USER_AGENT=

# --- Emplacement des données -------------------------------------------------
# Dans le conteneur, tout est écrit sous /data (le volume monté) : rien ailleurs.
# CIEL_DATA_DIR est déjà fixé par l'image ; ne le définissez ici QUE si vous
# lancez la collecte hors conteneur — sinon il s'appliquerait aussi aux
# exécutions locales (tests, outils) et les ferait écrire hors du dépôt.
# CIEL_DATA_DIR=/data
# Répertoire de l'HÔTE monté sur /data. Chemin relatif au compose, ou absolu.
CIEL_HOST_DATA_DIR=./data
# Propriétaire du répertoire hôte ci-dessus (doit correspondre, cf. procédure).
CIEL_UID=10001
CIEL_GID=10001

# --- Bounding box de captation (WGS84) ---------------------------------------
# Une requête /states/all sur une bbox <= 25 deg² coûte le MÊME crédit unique
# qu'une bbox de 1 deg² : on dimensionne donc large, pour englober les couloirs
# CDG / Orly / Le Bourget et toutes les stations candidates.
# Valeurs ci-dessous : 1,40° × 2,70° = 3,78 deg² (largement sous le seuil).
CT_BBOX_LAT_MIN=48.10
CT_BBOX_LON_MIN=1.30
CT_BBOX_LAT_MAX=49.50
CT_BBOX_LON_MAX=4.00

# --- Cadence de collecte -----------------------------------------------------
# 30 s => 2 880 appels/jour, sous le plafond quotidien de 4 000 crédits.
CT_POLL_INTERVAL_S=30
# Cadence plafond quand le garde-fou de budget étire l'intervalle.
CIEL_MAX_POLL_INTERVAL_S=300

# --- Budget crédits OpenSky (allocation QUOTIDIENNE) -------------------------
CT_DAILY_CREDIT_BUDGET=4000
# Sous ce solde, la collecte se met en pause puis relit le solde. Le quota
# OpenSky se réapprovisionne en cours de journée (constaté en collecte réelle) :
# on repart dès qu'il est revenu, sans attendre minuit.
CT_CREDIT_FLOOR=200
CIEL_CREDIT_RECHECK_S=600

# --- OAuth2 ------------------------------------------------------------------
# Durée de vie des jetons OpenSky (30 min) et marge de rafraîchissement anticipé.
CIEL_TOKEN_TTL_S=1800
CIEL_TOKEN_REFRESH_MARGIN_S=30

# --- Mode d'ingestion : "live" (API réelle) ou "replay" (hors ligne) ---------
CT_INGEST_MODE=live

# --- Stations Bruitparif -----------------------------------------------------
# Laisser vide : la résolution se fait dans l'ordre
#   $CIEL_DATA_DIR/stations.json (produit par le sondage) puis config/stations.json.
CIEL_STATIONS_FILE=
# Sondage : fenêtre diurne chargée du dernier jour complet, en heures UTC.
CIEL_PROBE_WINDOW_H=6
CIEL_PROBE_WINDOW_START_UTC=6
# Nombre de candidates interrogées, et plafond de stations retenues.
CIEL_PROBE_MAX_CANDIDATES=40
CIEL_MAX_ACTIVE_STATIONS=10

# --- Politesse réseau Bruitparif ---------------------------------------------
# Espacement entre appels. Le code impose un plancher DUR d'1 s : une valeur
# inférieure est ignorée.
CIEL_BRUITPARIF_PAUSE_S=1.5
CIEL_BRUITPARIF_MAX_RETRIES=3
CIEL_BRUITPARIF_BACKOFF_BASE_S=5

# --- Anti-troncature ---------------------------------------------------------
# /events plafonne à ~50 réponses, biaisées vers le début de l'intervalle.
# Au-delà de cap × ratio, la fenêtre est redécoupée puis rappelée.
CIEL_EVENTS_PAGE_CAP=50
CIEL_EVENTS_SATURATION_RATIO=0.9
CIEL_EVENTS_MIN_WINDOW_MIN=15

# --- Collecte de bruit (service `noise`) -------------------------------------
CIEL_NOISE_DAYS=2
CIEL_NOISE_INTERVAL_S=10800

# --- Compaction horaire ------------------------------------------------------
# On ne compacte jamais une heure encore alimentée par le poller.
CIEL_COMPACT_LAG_H=2
# Cadence des ordonnanceurs conteneurisés (utile si l'hôte n'a pas de cron).
CIEL_COMPACT_INTERVAL_S=3600
CIEL_STATUS_INTERVAL_S=900

# --- Comptage des paires -----------------------------------------------------
# Une heure n'est figée qu'une fois son bruit publié ET collecté.
CIEL_PAIRS_LAG_H=6
CIEL_PAIRS_MAX_SLANT_KM=10

# --- Seuils de supervision (status.json) -------------------------------------
# Âge maximal du dernier snapshot avant verdict KO.
CIEL_STATUS_MAX_SNAPSHOT_AGE_S=300
# Silence de la source bruit toléré EN JOURNÉE avant verdict KO.
# Ce seuil est relevé automatiquement à (cadence du collecteur + latence de
# publication) × 1,25 : plus serré, il basculerait en défaut avant chaque
# passage du collecteur, et l'alerte deviendrait du bruit de fond.
CIEL_NOISE_MAX_SILENCE_S=7200
# Latence de publication observée côté Bruitparif (~1 h).
CIEL_NOISE_PUBLICATION_LAG_S=3600
# Plage horaire UTC où du trafic est attendu (la nuit, le silence est normal).
CIEL_NOISE_DAY_START_UTC=5
CIEL_NOISE_DAY_END_UTC=21

# --- Notifications mobiles (ntfy) --------------------------------------------
# Vide = désactivé. Renseigné, la supervision publie sur ntfy à chaque
# CHANGEMENT d'état seulement (panne, rétablissement) plus un point quotidien.
# Jamais à chaque cycle : 96 notifications par jour et le canal est coupé.
#
# ATTENTION : le sujet vaut MOT DE PASSE — qui le connaît lit vos notifications.
# Prenez une chaîne longue et aléatoire, pas « ciel-tranquille » :
#   openssl rand -hex 16
# Puis abonnez-vous à ce sujet dans l'application ntfy (Android / iOS).
CIEL_NTFY_TOPIC=
# Instance publique par défaut ; remplaçable par une instance auto-hébergée.
CIEL_NTFY_URL=https://ntfy.sh
# Heure UTC du point quotidien. Son absence est le seul signal disponible si la
# supervision elle-même est morte : notez l'heure à laquelle vous l'attendez.
CIEL_NTFY_DIGEST_HOUR_UTC=7

# --- Plafonds de ressources des conteneurs -----------------------------------
# La machine héberge une production tierce : ces plafonds la protègent.
CIEL_PIDS_LIMIT=128
CIEL_POLLER_CPUS=0.50
CIEL_POLLER_MEMORY=512M
CIEL_NOISE_CPUS=0.50
CIEL_NOISE_MEMORY=512M
CIEL_COMPACT_CPUS=1.00
CIEL_COMPACT_MEMORY=1G
CIEL_STATUS_CPUS=1.00
CIEL_STATUS_MEMORY=1G
